<script>
document.addEventListener('DOMContentLoaded', function() {
    'use strict';

    var form = document.getElementById('testimonial-submit-form');
    if (!form) return;

    var ratingValue = document.getElementById('rating-value');
    var starPicker = document.getElementById('star-picker');
    var starBtns = starPicker.querySelectorAll('.star-btn');
    var starLabel = document.getElementById('star-label');
    var submitBtn = document.getElementById('submit-btn');
    var btnText = submitBtn.querySelector('.btn-text');
    var btnLoader = submitBtn.querySelector('.btn-loader');

    var i18n = <?= /* @noEscape */ json_encode([
        'poor' => (string) __('Poor'),
        'fair' => (string) __('Fair'),
        'good' => (string) __('Good'),
        'veryGood' => (string) __('Very Good'),
        'excellent' => (string) __('Excellent'),
        'nameRequired' => (string) __('Name is required.'),
        'emailRequired' => (string) __('Email is required.'),
        'emailInvalid' => (string) __('Please enter a valid email.'),
        'ratingRequired' => (string) __('Please select a rating.'),
        'titleRequired' => (string) __('Title is required.'),
        'contentRequired' => (string) __('Testimonial content is required.'),
        'thanksReview' => (string) __('Thank you! Your testimonial has been submitted for review.'),
        'wrong' => (string) __('Something went wrong. Please try again.'),
        'failed' => (string) __('Submission failed. Please try again.'),
        'network' => (string) __('Network error. Please check your connection.')
    ], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var labels = ['', i18n.poor, i18n.fair, i18n.good, i18n.veryGood, i18n.excellent];
    var selectedRating = 0;

    // Star rating picker
    function updateStars(rating, isHover) {
        starBtns.forEach(function(btn, idx) {
            var val = idx + 1;
            if (isHover) {
                btn.classList.toggle('hover', val <= rating);
            } else {
                btn.classList.toggle('active', val <= rating);
                btn.classList.remove('hover');
                btn.setAttribute('aria-checked', val === rating ? 'true' : 'false');
                btn.setAttribute('tabindex', (rating ? val === rating : val === 1) ? '0' : '-1');
            }
        });
        if (rating > 0) {
            starLabel.textContent = labels[rating] || '';
        }
    }

    starBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            selectedRating = parseInt(this.getAttribute('data-rating'));
            ratingValue.value = selectedRating;
            updateStars(selectedRating, false);
        });
        btn.addEventListener('keydown', function(e) {
            var cur = parseInt(this.getAttribute('data-rating'));
            var next = cur;
            if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { next = Math.min(5, cur + 1); }
            else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { next = Math.max(1, cur - 1); }
            else if (e.key === 'Home') { next = 1; }
            else if (e.key === 'End') { next = 5; }
            else { return; }
            e.preventDefault();
            selectedRating = next;
            ratingValue.value = next;
            updateStars(next, false);
            starBtns[next - 1].focus();
        });
        btn.addEventListener('mouseenter', function() {
            updateStars(parseInt(this.getAttribute('data-rating')), true);
        });
    });

    starPicker.addEventListener('mouseleave', function() {
        updateStars(selectedRating, false);
    });

    // Form key from cookie
    function getFormKey() {
        var match = document.cookie.match(/form_key=([^;]+)/);
        return match ? match[1] : '';
    }

    // Show toast
    function showToast(message, type) {
        var toast = document.getElementById('submit-toast');
        var toastMsg = document.getElementById('toast-message');
        toastMsg.textContent = message;
        toast.className = 'submit-toast ' + type;
        toast.style.display = 'block';
        toast.style.opacity = '1';
        setTimeout(function() {
            toast.style.opacity = '0';
            setTimeout(function() { toast.style.display = 'none'; }, 300);
        }, 4000);
    }

    // Clear errors
    function clearErrors() {
        form.querySelectorAll('.field-error').forEach(function(el) { el.textContent = ''; });
        form.querySelectorAll('.field-input, .field-textarea').forEach(function(el) {
            el.classList.remove('error');
            el.removeAttribute('aria-invalid');
            el.removeAttribute('aria-describedby');
        });
    }

    // Validate
    function validate() {
        clearErrors();
        var valid = true;

        var name = form.querySelector('[name="customer_name"]');
        if (!name.value.trim()) {
            showFieldError('customer_name', i18n.nameRequired);
            name.classList.add('error');
            valid = false;
        }

        var email = form.querySelector('[name="customer_email"]');
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email.value.trim()) {
            showFieldError('customer_email', i18n.emailRequired);
            email.classList.add('error');
            valid = false;
        } else if (!emailRegex.test(email.value.trim())) {
            showFieldError('customer_email', i18n.emailInvalid);
            email.classList.add('error');
            valid = false;
        }

        if (!ratingValue.value) {
            showFieldError('rating', i18n.ratingRequired);
            valid = false;
        }

        var title = form.querySelector('[name="title"]');
        if (!title.value.trim()) {
            showFieldError('title', i18n.titleRequired);
            title.classList.add('error');
            valid = false;
        }

        var content = form.querySelector('[name="content"]');
        if (!content.value.trim()) {
            showFieldError('content', i18n.contentRequired);
            content.classList.add('error');
            valid = false;
        }

        return valid;
    }

    function showFieldError(field, msg) {
        var el = form.querySelector('[data-error="' + field + '"]');
        if (el) {
            el.textContent = msg;
            el.id = 'pt-err-' + field;
        }
        var input = field === 'rating' ? document.getElementById('star-picker') : form.querySelector('[name="' + field + '"]');
        if (input) {
            if (field !== 'rating') input.setAttribute('aria-invalid', 'true');
            input.setAttribute('aria-describedby', 'pt-err-' + field);
        }
    }

    function focusFirstError() {
        var order = ['customer_name', 'customer_email', 'rating', 'title', 'content'];
        for (var i = 0; i < order.length; i++) {
            var el = form.querySelector('[data-error="' + order[i] + '"]');
            if (el && el.textContent) {
                var target = order[i] === 'rating' ? form.querySelector('#star-picker button') : form.querySelector('[name="' + order[i] + '"]');
                if (target) {
                    target.focus({ preventScroll: true });
                    target.scrollIntoView({ block: 'center', behavior: 'smooth' });
                }
                return;
            }
        }
    }

    // Submit via XHR
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (!validate()) {
            focusFirstError();
            return;
        }

        submitBtn.disabled = true;
        btnText.style.display = 'none';
        btnLoader.style.display = 'inline-flex';

        var formData = new FormData(form);
        formData.append('form_key', getFormKey());

        var xhr = new XMLHttpRequest();
        xhr.open('POST', form.action, true);
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

        xhr.onload = function() {
            submitBtn.disabled = false;
            btnText.style.display = 'inline';
            btnLoader.style.display = 'none';

            if (xhr.status >= 200 && xhr.status < 300) {
                try {
                    var resp = JSON.parse(xhr.responseText);
                    if (resp.success) {
                        showToast(resp.message || i18n.thanksReview, 'success');
                        form.reset();
                        selectedRating = 0;
                        updateStars(0, false);
                        ratingValue.value = '';
                        starLabel.textContent = '';
                    } else {
                        showToast(resp.message || i18n.wrong, 'error');
                    }
                } catch (ex) {
                    showToast(i18n.wrong, 'error');
                }
            } else {
                showToast(i18n.failed, 'error');
            }
        };

        xhr.onerror = function() {
            submitBtn.disabled = false;
            btnText.style.display = 'inline';
            btnLoader.style.display = 'none';
            showToast(i18n.network, 'error');
        };

        xhr.send(formData);
    });
});
</script>
