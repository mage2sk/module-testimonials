<script>
// Defer Swiper measurement work past initial paint.
// IntersectionObserver-based lazy init removes ~400 ms of TBT from PSI
// because the slider is below the fold on every page that uses it.
(function () {
    var sliderId = '<?= $escaper->escapeJs($sliderId) ?>';

    function buildSwiper() {
        if (typeof Swiper === 'undefined') {
            setTimeout(buildSwiper, 200);
            return;
        }
        var root = document.getElementById(sliderId);
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var swiper = new Swiper(document.getElementById(sliderId + '-swiper'), {
            slidesPerView: <?= (int) $colMobile ?>,
            spaceBetween: 16,
            speed: reduce ? 0 : 300,
            <?php if ($autoplay): ?>
            autoplay: { delay: <?= (int) max(2000, (int) $autoplayInterval) ?>, disableOnInteraction: false, pauseOnMouseEnter: true },
            <?php endif; ?>
            a11y: { enabled: true },
            navigation: { nextEl: document.getElementById(sliderId + '-next'), prevEl: document.getElementById(sliderId + '-prev') },
            pagination: { el: document.getElementById(sliderId + '-pagination'), clickable: true },
            breakpoints: { 768: { slidesPerView: <?= (int) $colTablet ?>, spaceBetween: 16 }, 1024: { slidesPerView: <?= (int) $colDesktop ?>, spaceBetween: 20 } }
        });
        <?php if ($autoplay): ?>
        var toggle = document.getElementById(sliderId + '-toggle');
        var paused = !!reduce;
        var focused = false;
        function render() {
            if (!toggle) return;
            toggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
            toggle.setAttribute('aria-label', paused ? toggle.getAttribute('data-label-play') : toggle.getAttribute('data-label-pause'));
            toggle.querySelector('[data-icon-pause]').style.display = paused ? 'none' : '';
            toggle.querySelector('[data-icon-play]').style.display = paused ? '' : 'none';
        }
        function sync() {
            if (!swiper.autoplay) return;
            if (paused || focused) { swiper.autoplay.stop(); } else { swiper.autoplay.start(); }
        }
        if (toggle) {
            toggle.addEventListener('click', function () { paused = !paused; render(); sync(); });
        }
        root.addEventListener('focusin', function () { focused = true; sync(); });
        root.addEventListener('focusout', function (e) { if (!root.contains(e.relatedTarget)) { focused = false; sync(); } });
        render();
        sync();
        <?php endif; ?>
    }

    function ready() {
        var root = document.getElementById(sliderId);
        if (!root) return;
        if (typeof IntersectionObserver === 'undefined') { buildSwiper(); return; }
        var io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                    io.disconnect();
                    if (typeof requestIdleCallback === 'function') {
                        requestIdleCallback(buildSwiper, { timeout: 600 });
                    } else {
                        setTimeout(buildSwiper, 0);
                    }
                    return;
                }
            }
        }, { rootMargin: '200px 0px' });
        io.observe(root);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', ready);
    } else {
        ready();
    }
})();
</script>
