                        <span class="px-2 py-2 text-sm text-fg-secondary select-none">&hellip;</span>
                    <?php elseif ((int) $page === $currentPage): ?>
                        <span class="pt-page-num inline-flex items-center justify-center w-10 h-10 text-sm font-bold text-white rounded-lg"
                              style="background: var(--color-primary-fill, #0F766E)"
                              aria-current="page"><?= (int) $page ?></span>
                    <?php else: ?>
                        <a href="<?= $escaper->escapeUrl($getPageUrl((int) $page)) ?>"
                           class="pt-page-num inline-flex items-center justify-center w-10 h-10 text-sm font-medium rounded-lg border border-gray-200 hover:border-gray-400 transition-colors no-underline"
