<section class="pt-listing py-8"
         id="panth-testimonials-listing"
         x-data="{
            selectedCategory: '<?= $escaper->escapeJs($selectedCategory ?: '') ?>',
            showSubmitModal: false,
            submitForm: { name: '', email: '', title: '', company: '', rating: 5, testimonialTitle: '', content: '', website: '' },
            submitting: false,
            submitSuccess: false,
            submitError: '',
            successMessage: '',
            hoverRating: 0,
            lastFocus: null,
            setRating(r) { this.submitForm.rating = r; },
            ratingKey(e, star) {
                let next = star;
                if (e.key === 'ArrowRight' || e.key === 'ArrowUp') next = Math.min(5, star + 1);
                else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') next = Math.max(1, star - 1);
                else if (e.key === 'Home') next = 1;
                else if (e.key === 'End') next = 5;
                else return;
                e.preventDefault();
                this.setRating(next);
                const g = e.target.closest('[role=radiogroup]'); const b = g ? g.querySelector('[data-star=&quot;' + next + '&quot;]') : null; if (b) b.focus();
            },
            openModal() {
                this.lastFocus = document.activeElement;
                this.showSubmitModal = true;
                setTimeout(() => { const f = document.getElementById('pt-m-name'); if (f) f.focus(); }, 60);
            },
            closeModal() {
                if (!this.showSubmitModal) return;
                this.showSubmitModal = false;
                if (this.lastFocus && this.lastFocus.focus) this.lastFocus.focus();
            },
            trapFocus(e) {
                const nodes = [...this.$refs.modalPanel.querySelectorAll('button, input:not([tabindex=&quot;-1&quot;]), textarea')].filter(n => n.offsetParent !== null && !n.disabled);
                if (!nodes.length) return;
                const first = nodes[0], last = nodes[nodes.length - 1];
                if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
                else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
            },
            async submitTestimonial() {
                this.submitError = '';
                const f = this.submitForm;
                if (!f.name.trim() || !f.email.trim() || !f.testimonialTitle.trim() || !f.content.trim()) {
                    this.submitError = '<?= $escaper->escapeJs(__('Please fill in all required fields.')) ?>';
                    return;
                }
                if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.email.trim())) {
                    this.submitError = '<?= $escaper->escapeJs(__('Please enter a valid email.')) ?>';
                    return;
                }
                this.submitting = true;
                try {
                    const fd = new FormData();
                    fd.append('customer_name', f.name);
                    fd.append('customer_email', f.email);
                    fd.append('customer_title', f.title);
                    fd.append('customer_company', f.company);
                    fd.append('rating', f.rating);
                    fd.append('title', f.testimonialTitle);
                    fd.append('content', f.content);
                    fd.append('website_url', f.website);
                    fd.append('form_key', hyva.getFormKey());
                    const r = await fetch('<?= $escaper->escapeJs($block->getUrl('testimonials/submit/save')) ?>', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    let data = null;
                    try { data = await r.json(); } catch (err) { data = null; }
                    if (r.ok && data && data.success) {
                        this.successMessage = data.message || '';
                        this.submitSuccess = true;
                        this.submitForm = { name: '', email: '', title: '', company: '', rating: 5, testimonialTitle: '', content: '', website: '' };
                    } else {
                        this.submitError = (data && data.message) ? data.message : '<?= $escaper->escapeJs(__('Submission failed. Please try again.')) ?>';
                    }
                } catch (e) { this.submitError = '<?= $escaper->escapeJs(__('An error occurred. Please try again.')) ?>'; }
                finally { this.submitting = false; }
            }
         }"
