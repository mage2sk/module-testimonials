<?php
/**
 * Panth Testimonials Widget - Hyva (snap-slider)
 * @var $block \Panth\Testimonials\Block\Widget\TestimonialSlider
 * @var $escaper \Magento\Framework\Escaper
 */
$testimonials = $block->getTestimonials();
if (!$testimonials || $testimonials->getSize() == 0) return;

$config = $block->getSliderConfig();
$sliderId = $block->getSliderId();
$jsId = preg_replace('/[^a-zA-Z0-9]/', '_', $sliderId);
$title = $escaper->escapeHtml(($config['title'] ?? '') ?: __('What Our Customers Say'));
$showRating = $config['show_rating'] ?? true;
$showCompany = $config['show_company'] ?? true;
$showImage = $config['show_image'] ?? true;
$autoplay = !empty($config['autoplay']);
$autoplayInterval = max(2000, (int)($config['autoplay_interval'] ?? 5000));
$testimonialItems = [];
foreach ($testimonials as $t) {
    $testimonialItems[] = $t;
}
$totalItems = count($testimonialItems);
?>

<section
    id="<?= $escaper->escapeHtmlAttr($sliderId) ?>"
    class="snap-slider pt-slider-hyva my-4"
    aria-label="<?= $escaper->escapeHtmlAttr($title) ?>"
    aria-roledescription="<?= $escaper->escapeHtmlAttr(__('carousel')) ?>"
    x-data
    x-snap-slider.group-pager
    x-defer="intersect"
>
    <div class="pt-slider-head">
        <h3 class="text-2xl font-bold text-fg m-0"><?= /* @noEscape */ $title ?></h3>
        <div class="pt-slider-controls">
            <?php if ($autoplay && $totalItems > 1): ?>
            <button type="button" class="btn btn-secondary pt-slider-btn" data-pt-autoplay-toggle
                    aria-pressed="false"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Pause automatic slide show')) ?>"
                    data-label-pause="<?= $escaper->escapeHtmlAttr(__('Pause automatic slide show')) ?>"
                    data-label-play="<?= $escaper->escapeHtmlAttr(__('Start automatic slide show')) ?>">
                <svg data-icon-pause width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>
                <svg data-icon-play width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <?php endif; ?>
            <button type="button" class="btn btn-secondary pt-slider-btn invisible" aria-label="<?= $escaper->escapeHtmlAttr(__('Previous')) ?>" data-prev disabled>
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" class="btn btn-secondary pt-slider-btn invisible" aria-label="<?= $escaper->escapeHtmlAttr(__('Next')) ?>" data-next disabled>
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
        </div>
    </div>

    <div class="snap-track pt-slider-track lg:[--snap-cols:3] p-1 -m-1"
         data-track tabindex="0" aria-live="<?= $autoplay ? 'off' : 'polite' ?>">
        <?php foreach ($testimonialItems as $index => $t): ?>
            <?php
            $rating = (int)$t->getRating();
            $nameParts = preg_split('/\s+/u', trim((string) $t->getCustomerName())) ?: [''];
            $initials = mb_strtoupper(mb_substr($nameParts[0], 0, 1) . mb_substr($nameParts[1] ?? '', 0, 1));
            $meta = array_filter([$t->getCustomerTitle(), $t->getCustomerCompany()]);
            ?>
            <div id="<?= $escaper->escapeHtmlAttr($sliderId . '-' . $t->getId()) ?>"
                 class="pt-slide flex flex-col border border-gray-200 rounded-2xl p-6 bg-white transition-shadow"
                 role="group"
                 aria-label="<?= $escaper->escapeHtmlAttr(__('%1 of %2', $index + 1, $totalItems)) ?>">

                <?php if ($showRating && $rating > 0): ?>
                <div class="flex mb-3" style="gap:1px;">
                    <span class="pt-sr-only"><?= $escaper->escapeHtml(__('Rated %1 out of 5', $rating)) ?></span>
                    <?php for ($i = 1; $i <= 5; $i++): ?>
                    <span aria-hidden="true" style="color:<?= $i <= $rating ? '#EAB308' : '#D4D4D4' ?>;font-size:16px;line-height:1;">&#9733;</span>
                    <?php endfor; ?>
                </div>
                <?php endif; ?>

                <h4 class="text-base font-bold text-fg m-0 mb-2 leading-snug"><?= $escaper->escapeHtml($t->getTitle()) ?></h4>

                <p class="pt-slide-quote text-sm leading-relaxed text-gray-500 mb-5 flex-1 m-0">
                    <span class="text-lg font-bold leading-none" aria-hidden="true" style="color:var(--color-primary-fill, #0F766E);margin-right:2px;">&ldquo;</span><?= $escaper->escapeHtml($t->getShortContent() ?: mb_substr(strip_tags((string) $t->getContent()), 0, 150)) ?>
                </p>

                <div class="flex items-center gap-3 mt-auto pt-4 border-t border-gray-100">
                    <?php if ($showImage): ?>
                    <?php $imageUrl = $block->getCustomerImageUrl($t); ?>
                    <div class="pt-avatar-40 rounded-full overflow-hidden flex-shrink-0 flex items-center justify-center text-sm font-bold text-white"
                         style="background:linear-gradient(135deg, var(--color-primary-fill, #0F766E), color-mix(in srgb, var(--color-primary-fill, #0F766E) 70%, #000));">
                        <?php if ($imageUrl): ?>
                        <img src="<?= $escaper->escapeUrl($imageUrl) ?>" alt="<?= $escaper->escapeHtmlAttr($t->getCustomerName()) ?>"
                             width="40" height="40" loading="lazy" class="pt-img-cover"/>
                        <?php else: ?>
                        <span aria-hidden="true"><?= $escaper->escapeHtml($initials) ?></span>
                        <?php endif; ?>
                    </div>
                    <?php endif; ?>
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-fg m-0 truncate"><?= $escaper->escapeHtml($t->getCustomerName()) ?></p>
                        <?php if ($showCompany && !empty($meta)): ?>
                        <p class="text-xs text-fg-secondary m-0 truncate"><?= $escaper->escapeHtml(implode(', ', $meta)) ?></p>
                        <?php endif; ?>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>

    <?php if ($totalItems > 1): ?>
    <div class="panth-tst-pager"
         x-data="testimonialPager_<?= $escaper->escapeHtmlAttr($jsId) ?>()"
         x-show="pages > 1"
         x-cloak>
        <template x-for="p in pages" :key="p">
            <button type="button"
                    class="panth-tst-dot"
                    :class="{ 'is-active': activePage === p - 1 }"
                    :aria-current="activePage === p - 1 ? 'true' : 'false'"
                    :aria-label="'<?= $escaper->escapeJs(__('Page')) ?> ' + p"
                    @click="goToPage(p - 1)">
                <span aria-hidden="true"></span>
            </button>
        </template>
    </div>
    <script>
        function testimonialPager_<?= $escaper->escapeJs($jsId) ?>() {
            return {
                activePage: 0,
                pages: 0,
                track: null,
                timer: null,
                paused: false,
                hovering: false,
                focused: false,
                init() {
                    const section = this.$el.closest('.snap-slider');
                    this.track = section ? section.querySelector('[data-track]') : null;
                    if (!this.track) return;
                    this.track.addEventListener('scroll', () => this.updateActive(), { passive: true });
                    window.addEventListener('resize', () => this.updateActive());
                    setTimeout(() => this.updateActive(), 100);
                    <?php if ($autoplay): ?>
                    const toggle = section.querySelector('[data-pt-autoplay-toggle]');
                    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    this.paused = reduce;
                    const render = () => {
                        if (!toggle) return;
                        toggle.setAttribute('aria-pressed', this.paused ? 'true' : 'false');
                        toggle.setAttribute('aria-label', this.paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause);
                        toggle.querySelector('[data-icon-pause]').style.display = this.paused ? 'none' : '';
                        toggle.querySelector('[data-icon-play]').style.display = this.paused ? '' : 'none';
                    };
                    const sync = () => {
                        clearInterval(this.timer);
                        this.timer = null;
                        if (this.paused || this.hovering || this.focused || document.hidden) return;
                        this.timer = setInterval(() => this.advance(), <?= (int) $autoplayInterval ?>);
                    };
                    if (toggle) {
                        toggle.addEventListener('click', () => { this.paused = !this.paused; render(); sync(); });
                    }
                    section.addEventListener('mouseenter', () => { this.hovering = true; sync(); });
                    section.addEventListener('mouseleave', () => { this.hovering = false; sync(); });
                    section.addEventListener('focusin', () => { this.focused = true; sync(); });
                    section.addEventListener('focusout', (e) => { if (!section.contains(e.relatedTarget)) { this.focused = false; sync(); } });
                    document.addEventListener('visibilitychange', sync);
                    render();
                    sync();
                    <?php endif; ?>
                },
                advance() {
                    if (!this.track) return;
                    const slides = this.track.children;
                    const slideWidth = slides[0] ? slides[0].offsetWidth + parseInt(getComputedStyle(this.track).columnGap || 0) : 0;
                    if (this.track.scrollLeft + this.track.offsetWidth >= this.track.scrollWidth - 10) {
                        this.track.scrollTo({ left: 0, behavior: 'smooth' });
                    } else {
                        this.track.scrollBy({ left: slideWidth, behavior: 'smooth' });
                    }
                },
                updateActive() {
                    if (!this.track) return;
                    const slides = this.track.children;
                    if (!slides.length) return;
                    const slideWidth = slides[0].offsetWidth + parseInt(getComputedStyle(this.track).columnGap || 0);
                    const cols = Math.max(1, Math.round(this.track.offsetWidth / slides[0].offsetWidth));
                    this.pages = Math.ceil(slides.length / cols);
                    this.activePage = Math.min(this.pages - 1, Math.round(this.track.scrollLeft / (slideWidth * cols)));
                },
                goToPage(page) {
                    if (!this.track) return;
                    const slides = this.track.children;
                    if (!slides.length) return;
                    const slideWidth = slides[0].offsetWidth + parseInt(getComputedStyle(this.track).columnGap || 0);
                    const cols = Math.max(1, Math.round(this.track.offsetWidth / slides[0].offsetWidth));
                    this.track.scrollTo({ left: page * slideWidth * cols, behavior: 'smooth' });
                }
            };
        }
    </script>
    <?php endif; ?>

    <span id="<?= $escaper->escapeHtmlAttr($sliderId) ?>-end" tabindex="-1"></span>
</section>
